# Production is the default; .env is NOT automatically loaded by the service.
# BJWGBY deployment: use deployment/bjwgby-production.env.example instead.
APP_ENV=production
HTTP_ADDRESS=127.0.0.1:8080
API_TOKEN=replace-with-at-least-32-random-bytes

# Explicit production identity / database / DC. UPN suffix defaults to mail domain.
EXCHANGE_MAIL_DOMAIN=
EXCHANGE_UPN_SUFFIX=
# Optional creation location, NOT an RBAC restriction. Blank uses Exchange's default.
EXCHANGE_ORGANIZATIONAL_UNIT=
EXCHANGE_MAILBOX_DATABASE=
EXCHANGE_DOMAIN_CONTROLLER=
EXCHANGE_STATE_DIRECTORY=/var/lib/exchange-automation
EXCHANGE_RESET_PASSWORD_ON_NEXT_LOGON=false
EXCHANGE_BYPASS_GROUP_MANAGER_CHECK=true
EXCHANGE_OPERATION_TIMEOUT=5m
EXCHANGE_MAX_CONCURRENT_OPERATIONS=2

# Direct Exchange endpoint: no ordinary Windows PowerShell login or delegation.
EXCHANGE_CONNECTION_MODE=direct
EXCHANGE_POWERSHELL_URL=http://replace-with-exchange-fqdn/PowerShell/
EXCHANGE_AUTH=kerberos
# Owner-readable JSON: {"username":"svc@example.com","password":"..."}; chmod 600.
# Kerberos accepts any case for the AD UPN realm; account spelling/password stay unchanged.
# Must be readable by the dedicated Linux service user.
EXCHANGE_CREDENTIAL_FILE=/etc/exchange-automation/credentials.json
# Alternatively unset EXCHANGE_CREDENTIAL_FILE and inject both variables:
# EXCHANGE_USERNAME=svc@example.com
# EXCHANGE_PASSWORD=replace-with-secret
# KRB5_CONFIG=/etc/krb5.conf
EXCHANGE_PYTHON_BINARY=/opt/exchange-automation/.venv/bin/python
# NTLM is optional ONLY when the existing HTTPS Exchange endpoint and domain policy allow it.
# EXCHANGE_AUTH=ntlm
# EXCHANGE_POWERSHELL_URL=https://replace-with-exchange-fqdn/PowerShell/
# REQUESTS_CA_BUNDLE=/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem
