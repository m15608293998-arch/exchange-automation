# Go HTTP service. Keep loopback when a local reverse proxy provides Keycloak auth.
HTTP_ADDRESS=127.0.0.1:8080

# Exchange mailbox defaults.
EXCHANGE_MAIL_DOMAIN=bjwgby.com
EXCHANGE_ORGANIZATIONAL_UNIT=
EXCHANGE_MAILBOX_DATABASE=
EXCHANGE_RESET_PASSWORD_ON_NEXT_LOGON=false
EXCHANGE_BYPASS_GROUP_MANAGER_CHECK=true
EXCHANGE_OPERATION_TIMEOUT=2m

# Exchange test target and WinRM connection.
EXCHANGE_HOST=192.168.6.77
EXCHANGE_WINRM_USER=svc_exchange_auto@exchlab.local
EXCHANGE_WINRM_PASSWORD=replace-with-secret
EXCHANGE_WINRM_PORT=5986
EXCHANGE_WINRM_SCHEME=https
EXCHANGE_WINRM_TRANSPORT=ntlm
EXCHANGE_WINRM_CERT_VALIDATION=ignore
EXCHANGE_WINRM_OPERATION_TIMEOUT=60
EXCHANGE_WINRM_READ_TIMEOUT=70

# Optional Ansible path overrides.
ANSIBLE_PLAYBOOK_BINARY=ansible-playbook
ANSIBLE_INVENTORY=automation/inventory/hosts.yml
ANSIBLE_PLAYBOOK=automation/playbooks/exchange_operation.yml
ANSIBLE_LOCAL_TEMP=/tmp/exchange-automation-ansible
