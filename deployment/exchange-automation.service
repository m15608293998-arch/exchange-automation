[Unit]
Description=Exchange mailbox automation
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=exchange-automation
Group=exchange-automation
WorkingDirectory=/opt/exchange-automation
EnvironmentFile=/etc/exchange-automation.env
ExecStart=/opt/exchange-automation/bin/exchange-automation
StateDirectory=exchange-automation
StateDirectoryMode=0700
RuntimeDirectory=exchange-automation
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
KillMode=mixed
# Must exceed EXCHANGE_OPERATION_TIMEOUT + 20 seconds.
TimeoutStopSec=330
Restart=on-failure

[Install]
WantedBy=multi-user.target
