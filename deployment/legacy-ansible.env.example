# Explicit rollback only; does not change/remove permissions on the Exchange server.
# Add these to the business/API/state settings. Do not switch during an active operation.
EXCHANGE_CONNECTION_MODE=ansible
EXCHANGE_HOST=
EXCHANGE_SERVER_FQDN=
EXCHANGE_WINRM_USER=
EXCHANGE_WINRM_PASSWORD=replace-with-secret
EXCHANGE_WINRM_SCHEME=http
EXCHANGE_WINRM_PORT=5985
EXCHANGE_PSRP_AUTH=kerberos
EXCHANGE_KERBEROS_SERVICE=HTTP
EXCHANGE_WINRM_CERT_VALIDATION=validate
EXCHANGE_IGNORE_PROXY=true
EXCHANGE_WINRM_OPERATION_TIMEOUT=60
EXCHANGE_WINRM_READ_TIMEOUT=70
ANSIBLE_PLAYBOOK_BINARY=/opt/exchange-automation/.venv/bin/ansible-playbook
ANSIBLE_INVENTORY=automation/inventory/hosts.yml
ANSIBLE_PLAYBOOK=automation/playbooks/exchange_operation.yml
ANSIBLE_LOCAL_TEMP=/run/exchange-automation
