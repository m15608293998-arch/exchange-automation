# Test laboratory only. Inject actual credentials separately; never commit them.
APP_ENV=test
HTTP_ADDRESS=127.0.0.1:8080
EXCHANGE_MAIL_DOMAIN=bjwgby.com
EXCHANGE_UPN_SUFFIX=bjwgby.com
EXCHANGE_CONNECTION_MODE=direct
EXCHANGE_POWERSHELL_URL=http://exchlab.exchlab.local/PowerShell/
EXCHANGE_AUTH=kerberos
# Resolve exchlab.exchlab.local -> 192.168.6.77 in laboratory DNS or controller hosts.
EXCHANGE_CREDENTIAL_FILE=/run/exchange-automation-test/credentials.json
EXCHANGE_DOMAIN_CONTROLLER=exchlab.exchlab.local
EXCHANGE_STATE_DIRECTORY=/tmp/exchange-automation-test-state
KRB5_CONFIG=automation/krb5.test.conf
# API_TOKEN and the private credential file must be supplied before startup.
# Leave OU/database unset only in this laboratory, to use Exchange defaults.
