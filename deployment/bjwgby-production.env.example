# Tailored from the administrator's read-only production collection.
# Copy to /etc/exchange-automation.env and replace every replace-with-* value.
# systemd EnvironmentFile syntax; do not execute this file as a shell script.
APP_ENV=production
HTTP_ADDRESS=replace-with-linux-service-ip:8080
# Optional; empty means no Authorization header is required.
API_TOKEN=

# Employee identity and placement. The production AD and employee mail suffix match.
EXCHANGE_MAIL_DOMAIN=bjwgby.com
EXCHANGE_UPN_SUFFIX=bjwgby.com
EXCHANGE_ORGANIZATIONAL_UNIT=
EXCHANGE_MAILBOX_DATABASE="Mailbox Database 1119980504"
EXCHANGE_DOMAIN_CONTROLLER=EXCHANGE.BJWGBY.COM
EXCHANGE_STATE_DIRECTORY=/var/lib/exchange-automation
EXCHANGE_RESET_PASSWORD_ON_NEXT_LOGON=false
EXCHANGE_BYPASS_GROUP_MANAGER_CHECK=true
EXCHANGE_OPERATION_TIMEOUT=5m
EXCHANGE_MAX_CONCURRENT_OPERATIONS=2

# Direct Kerberos connection to the real server FQDN. Do not replace this with
# the mail.bjwgby.com IIS alias unless its HTTP SPN has been separately verified.
EXCHANGE_CONNECTION_MODE=direct
EXCHANGE_POWERSHELL_URL=http://EXCHANGE.BJWGBY.COM/PowerShell/
EXCHANGE_AUTH=kerberos
EXCHANGE_CREDENTIAL_FILE=/etc/exchange-automation/credentials.json
KRB5_CONFIG=/etc/exchange-automation/krb5.conf
EXCHANGE_PYTHON_BINARY=/opt/exchange-automation/.venv/bin/python
